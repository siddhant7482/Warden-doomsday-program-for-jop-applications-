# Local dev database (docker compose -f ../../docker-compose.dev.yml up -d)
DATABASE_URL="postgresql://commandhq:localdev@localhost:5433/warden"

# OpenRouter — messy-tail email extraction and daily message generation.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_TRIAGE_MODEL="anthropic/claude-haiku-4.5"
OPENROUTER_EXTRACT_MODEL="anthropic/claude-sonnet-4.5"

# Encrypts the Gmail refresh token before it reaches Postgres, because
# pg_dump goes offsite to Backblaze. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Google OAuth for Gmail ingestion (readonly scope only).
# Redirect URI must match Google Cloud Console EXACTLY.
# Local:      http://localhost:3000/api/auth/google/callback
# On the box: http://jobs.hq/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
# Optional: override the Gmail search that narrows before fetching.
GMAIL_QUERY=""

# Outbound mail for witness notices. Irreversible once sent, by design.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="warden@commandhq.local"
